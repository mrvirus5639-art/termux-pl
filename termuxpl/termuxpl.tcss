/* Termux PL theme: black background, magenta frames, cyan text, yellow cursor */

Screen {
    background: #000000;
    color: #38bdf8;
    layout: vertical;
}

* {
    scrollbar-color: #7a2c80;
    scrollbar-color-hover: #e879f9;
    scrollbar-color-active: #e879f9;
    scrollbar-background: #0b0b0f;
    scrollbar-size-vertical: 1;
}

#top, #progress, #searchbox, #results, #queuebox, .box {
    border: round #e879f9;
    border-title-color: #e879f9;
    border-subtitle-color: #e879f9;
    border-title-align: left;
    border-subtitle-align: left;
    background: #000000;
}

#top {
    height: 3fr;
    min-height: 7;
    padding: 0 1;
}
/* #art width is set from the panel height in app.py so the art stays square */
#art { width: 34; height: 1fr; }
#sep { width: 6; height: 1fr; }
#infocol { width: 1fr; height: 1fr; padding: 0 1; }
#info { height: 1fr; }
#minispec { height: 4; }
#lyrics { width: 1fr; height: 1fr; padding: 0 1; }
#idle { width: 1fr; height: 1fr; padding: 0 1; }

#mid { height: 6; }
#progress { width: 1fr; height: 6; padding: 0 1; }
#wave { height: 1fr; }
#controls { width: 50; height: 6; padding: 0 0 0 1; }
#btnrow { height: 3; }
#volume { height: 3; padding: 0 1; }

Button {
    width: 1fr;
    min-width: 5;
    height: 3;
    border: round #e879f9;
    background: #000000;
    color: #e879f9;
    text-style: none;
    margin: 0 0 0 1;
}
Button:hover { background: #2a0f2e; color: #f5d0fe; }
Button:focus { border: round #fde047; text-style: bold; background: #000000; }
Button.-active { background: #3b0f40; }
#btnrow Button:first-of-type { margin: 0; }

#searchrow { height: 3; }
#searchbox { width: 1fr; height: 3; padding: 0 1; }
#prefix { width: 4; color: #38bdf8; }
#search {
    width: 1fr;
    border: none;
    height: 1;
    padding: 0;
    background: #000000;
    color: #38bdf8;
}
#search:focus { border: none; background: #000000; }
#btn-mode { width: 7; max-width: 7; }

#bottom { height: 2fr; min-height: 5; }
#results { width: 1fr; height: 1fr; }
#queuebox { width: 1fr; height: 1fr; margin-left: 1; }
#queue { height: 1fr; border: none; background: #000000; }
#queue-empty {
    width: 1fr;
    height: 1fr;
    content-align: center middle;
    color: #38bdf8;
}

DataTable {
    background: #000000;
    color: #38bdf8;
}
DataTable > .datatable--cursor { background: #3f3f46; color: #fde047; text-style: bold; }
DataTable:blur > .datatable--cursor { background: #1f1f24; color: #fde047; }
DataTable > .datatable--hover { background: #18181b; }
DataTable > .datatable--header { background: #000000; color: #e879f9; }

#status {
    height: 1;
    padding: 0 1;
    color: #94a3b8;
    background: #0b0b0f;
}

/* -------------------------------------------------------------- menus */
ModalScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.75);
}
.menu {
    width: 94%;
    height: 92%;
    border: double #e879f9;
    background: #000000;
    padding: 0 1;
}
.menu-title { color: #e879f9; text-style: bold; width: 1fr; padding: 0 0 1 0; }
.row { height: 1fr; }
.col { width: 1fr; height: 1fr; margin-right: 1; padding: 0 1; }
.narrow { width: 26%; min-width: 22; }
.btns { height: auto; padding: 1 0 0 0; }
.btns Button { width: auto; min-width: 0; padding: 0 1; margin: 0 1 0 0; }
.btns.tight { padding: 0; }
.hint { color: #64748b; height: auto; }
.path { color: #64748b; height: auto; padding-bottom: 1; }
.field { height: 3; }
.flabel { width: 13; padding: 1 1 0 0; color: #e879f9; }
.slabel { padding: 1 0 0 1; color: #38bdf8; }
Input {
    background: #000000;
    border: round #5b3b55;
    color: #38bdf8;
}
Input:focus { border: round #e879f9; }
Switch { background: #000000; border: round #5b3b55; }
Switch:focus { border: round #e879f9; }
Switch > .switch--slider { color: #3f3f46; background: #18181b; }
Switch.-on > .switch--slider { color: #e879f9; }
TabbedContent { height: 1fr; }
TabPane { padding: 0; }
Tabs { background: #000000; }
Tab { color: #64748b; }
Tab.-active { color: #e879f9; }
#manual-scroll { height: 1fr; }
Markdown { background: #000000; color: #cbd5e1; }
#pl-list, #pl-tracks, #pl-lib, #md-table, #s-dirs, #h-top, #h-recent { height: 1fr; }
